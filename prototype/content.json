      {
        "speaker": "{characterName}",
        "portrait": "kael",
        "text": "나는 {characterName}이야."
      },
      {
        "speaker": "{characterName}",
        "portrait": "kael",
        "text": "그런데 무슨 일 있어?"
      },
      {
        "speaker": "{characterName}",
        "portrait": "kael",
        "text": "아까부터 자꾸 어디를 보고 있네."
